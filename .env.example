# AiFundMe — environment template; copy to .env.local
# Fill blank values as integrations are implemented; the scaffold needs no keys.
# Plan: docs/deployment.md. Never commit this file or expose secrets to the browser.
# Use quotes for values containing spaces or #. Keep credentials on one line.

# --- Postgres through Vercel Marketplace (Neon) ---
# Connect Postgres in Vercel Storage/Marketplace and copy its development URLs.
# Pooled connection for the application:
DATABASE_URL=
# Direct/unpooled connection to the SAME database, for migrations:
DATABASE_URL_UNPOOLED=

# --- GitHub-only sign-in and public repository access ---
BETTER_AUTH_URL=http://localhost:3000
# Generate an independent random session secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# GitHub > Settings > Developer settings > OAuth Apps > development app.
# Homepage: http://localhost:3000
# Callback: http://localhost:3000/api/auth/callback/github
# OAuth App credentials, NOT a GitHub App private key or personal access token:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# User OAuth tokens come from login and are encrypted in Postgres.
# Per-repository webhook secrets are generated and encrypted there too.

# --- Credential encryption in Postgres ---
# Generate a DIFFERENT random 32-byte key: openssl rand -base64 32
# This is the AES-256-GCM encryption key, encoded as base64.
# Keep it outside the DB, source code, logs, workflow inputs/results, and workers.
# Keep it stable across restarts/deployments; losing it makes saved keys unreadable.
# Use a separate production key and an explicit migration for future rotation.
CREDENTIAL_ENCRYPTION_KEY_BASE64=

# --- Vercel: platform team, hosting, Workflow, and Sandbox ---
# Team-scoped token from Vercel account settings; used for app provisioning.
VERCEL_TOKEN=
# Team ID (typically team_...), not the display name:
VERCEL_TEAM_ID=
# AiFundMe platform project ID (typically prj_...), available after project linking:
VERCEL_PROJECT_ID=
# Optional until deployment webhooks are configured; use their signing secret:
VERCEL_WEBHOOK_SECRET=
# Hosted Workflow needs no separate service API key.
# Sandbox uses Vercel OIDC; local access may need a short-lived CLI-provided token.
# VERCEL_OIDC_TOKEN=

# --- Recovery/cleanup Cron only; Workflow runs the agent ---
# Generate a third independent secret: openssl rand -base64 32
# The cron endpoint must verify the Authorization: Bearer header.
CRON_SECRET=

# --- OpenRouter ---
# Default model; validated project overrides will be configurable.
AI_DEFAULT_MODEL=openai/gpt-6-astra
# Optional local integration-test key from OpenRouter, with a small spending cap.
# Real calls still require an explicit budgeted test grant.
# NOT a shared production fallback: contributor keys are encrypted per grant in DB.
OPENROUTER_TEST_API_KEY=
# No direct OpenAI key is needed.

# --- Stripe: TEST payments only ---
STRIPE_MODE=test
# Use a restricted test key (rk_test_...) with required permissions, or sk_test_...
# from the intended Stripe test account/sandbox. Never enter a live key.
STRIPE_SECRET_KEY=
# Separate webhook signing secret (whsec_...). For local development, obtain via:
# stripe listen --forward-to localhost:3000/api/webhooks/stripe
# The hosted webhook has its own signing secret configured in Vercel.
STRIPE_WEBHOOK_SECRET=
# Hosted Checkout redirects need no publishable key in the initial implementation.

# No AWS, Inngest, Redis, or Blob credentials are needed.
# Small source artifacts/logs are stored in Postgres; published code lives in GitHub.
